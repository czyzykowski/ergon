{
  "name": "ergon",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "imports": {
    "cliffy/": "https://deno.land/x/cliffy@v0.25.7/",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.2",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0",
    "path/": "https://deno.land/std@0.224.0/path/",
    "yaml/": "https://deno.land/std@0.224.0/yaml/"
  },
  "tasks": {
    "ergon": "deno run --allow-net --allow-read --allow-env --allow-write --allow-run src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "coverage": "deno test --allow-read --allow-write --allow-env --coverage=coverage",
    "coverage:report": "deno coverage coverage"
  }
}
