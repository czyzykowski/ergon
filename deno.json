{
  "name": "ergon",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "nodeModulesDir": "auto",
  "exclude": [
    ".claude/",
    ".deno-types.d.ts",
    ".direnv/",
    ".scratch/",
    ".stryker-tmp/",
    "coverage/",
    "reports/",
    "specs/"
  ],
  "imports": {
    "@stryker-mutator/api/": "npm:/@stryker-mutator/api@10.1.1/",
    "@stryker-mutator/core": "npm:@stryker-mutator/core@10.1.1",
    "cliffy/": "https://deno.land/x/cliffy@v0.25.7/",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.2",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0",
    "path/": "https://deno.land/std@0.224.0/path/",
    "testing/": "https://deno.land/std@0.224.0/testing/",
    "yaml/": "https://deno.land/std@0.224.0/yaml/"
  },
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "plugins": ["./lint/atomic-write.ts"],
    "rules": {
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-non-null-assertion",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "verbatim-module-syntax"
      ]
    }
  },
  "tasks": {
    "ergon": "deno run --allow-net --allow-read --allow-env --allow-write --allow-run src/main.ts",
    "test": "deno test --parallel --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1",
    "check": "deno task check:static && deno task test",
    "check:static": "deno fmt --check && deno lint && deno check src tests scripts lint && deno task lint:ox",
    "lint:ox": "deno types > .deno-types.d.ts && oxlint --type-aware --deny-warnings src tests scripts lint",
    "check:nix": "deadnix --fail flake.nix && statix check flake.nix && nixfmt --check flake.nix",
    "coverage": "deno test --parallel --clean --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 --coverage=coverage",
    "coverage:report": "deno coverage coverage",
    "coverage:check": "deno task coverage && deno coverage --lcov --exclude=tests/ coverage | deno run scripts/check-coverage.ts 68 81",
    "mutate": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost scripts/mutate.ts"
  }
}
